DATABASE_URL=""
PORT=""
JWT_SECRET=""
JWT_EXPIRE_IN=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

FRONTEND_URL="http://localhost:3000"
# Optional comma-separated REST and Socket.IO origin allowlist; defaults to FRONTEND_URL.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

TEST_USER_EMAIL=""
TEST_USER_PASSWORD=""

# Use deterministic local AI responses while developing without OpenRouter credentials.
AI_MOCK_MODE="true"
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AI_ANALYZE_IMAGE_MODEL="openrouter/free"
AI_ANALYZE_IMAGE_MODEL_FREE="openrouter/free"
AI_IMAGE_EMBEDDING_MODEL="nvidia/llama-nemotron-embed-vl-1b-v2:free"
//Embedding ต้องเป็น model ที่รองรับ Multomodal CLIP
//Multimodal Embedding (vision-language)คือการแปลงข้อมูล หลายประเภท (หลาย modality) เช่น รูปภาพและข้อความ ให้กลายเป็น ตัวเลข Vector ที่อยู่ในพื้นที่เดียวกัน เพื่อเอามาวัดว่า “สองสิ่งนี้คล้าย/เกี่ยวข้องกันแค่ไหน”
//CLIP ย่อมาจาก Contrastive Language–Image Pre-training คือ Multimodal Embedding Model แบบหนึ่ง ที่เปลี่ยนทั้ง "รูป" และ "ข้อความ" เป็น Vector เพื่อวัดความสัมพันธ์/ความคล้ายกันได้
AI_IMAGE_EMBEDDING_DIMENSION=768
# Real avatar generation is disabled in the free-only release.
AI_PET_AVATAR_MODEL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""

# Prototype reverse geocoding (public Nominatim has no production SLA).
# Keep the User-Agent application-specific; do not put real contact data here.
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="PAWND/1.0"
NOMINATIM_TIMEOUT_MS="5000"



TEST_USER_EMAIL=""
TEST_USER_PASSWORD=""

GMAIL_SMTP_USER=""
GMAIL_SMTP_APP_PASSWORD=""